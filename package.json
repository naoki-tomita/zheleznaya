{
  "name": "zheleznaya",
  "version": "0.3.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": "https://github.com/naoki-tomita/zheleznaya",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "esbuild index.ts --bundle --format=esm --sourcemap --outdir=dist",
    "typecheck": "tsc",
    "lint": "npx prettier --write '{**,.}/*.ts' '!dist/**'",
    "preversion": "yarn lint && yarn build",
    "postversion": "git push --follow-tags",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite"
  }
}
